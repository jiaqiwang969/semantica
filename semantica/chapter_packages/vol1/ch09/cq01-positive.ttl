@prefix mfg: <http://example.org/manufacturing#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mfg:Aluminum a mfg:Material .
mfg:Lathe_001 a mfg:Equipment ;
    mfg:canProcess mfg:Aluminum ;
    rdfs:label "数控车床一号"@zh ;
    mfg:power "15.0"^^xsd:float .
mfg:Mill_002 a mfg:Equipment ;
    mfg:canProcess mfg:Aluminum ;
    rdfs:label "立式铣床二号"@zh ;
    mfg:power "11.0"^^xsd:float .
mfg:Press_003 a mfg:Equipment ;
    rdfs:label "液压机三号"@zh .

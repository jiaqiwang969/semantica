@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix dep: <https://product-trustworthiness.local/dependency#> .
dep: a owl:Ontology .
dep:DependencySeam a owl:Class .
dep:Exclusion a owl:Class .
dep:IndependenceClaim a owl:Class .
dep:feedsFrom a owl:ObjectProperty, owl:TransitiveProperty .
dep:restsOn a owl:ObjectProperty .
dep:supersededBy a owl:ObjectProperty .
dep:hasExclusion a owl:ObjectProperty .
